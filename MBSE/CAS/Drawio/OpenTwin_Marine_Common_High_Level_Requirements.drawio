<mxfile host="app.diagrams.net" agent="jfxai4mss requirements refactor" version="24.7.17" type="device">
  <diagram id="COM-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — Common High-Level Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;All three CAD concepts&lt;br&gt;&lt;br&gt;Illustrated callouts are concept evidence; dimensions and performance require design/analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Baseline interpretation&lt;/b&gt;&lt;br&gt;Shared allocation only; each asset must implement and verify applicable COM requirements. No common performance values are inferred." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Requirements status&lt;/b&gt;&lt;br&gt;Proposed high-level requirements. Named owners are proposed engineering roles, not assigned people. Acceptance budgets and dates require project assignment. No completion/certification claim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission / stakeholders&lt;/b&gt;&lt;br&gt;Operator, occupants/crew, payload team, naval architect, controls/energy engineers and maintainers.&lt;br&gt;Scenario: configure → inspect → operate under local authority → dock/recover → maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="shared" value="&lt;b&gt;Shared requirements allocation&lt;/b&gt;&lt;br&gt;COM-01 through COM-12 apply to the three asset specifications.&lt;br&gt;Traceability register: docs/requirements/cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Boundary / exclusions&lt;/b&gt;&lt;br&gt;Concept requirements and interfaces for MBSE/CAD/simulation. Numerical budgets, production geometry and verification evidence are unresolved. Unillustrated variants require a separate configuration decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-2" name="02 — High-level requirements 1–9">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — Common High-Level Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="COM-01" value="&lt;b&gt;COM-01 — Configuration&lt;/b&gt;&lt;br&gt;SHALL maintain a versioned asset and installed-module inventory linking CAD reference, mass/CG budget, interface revision and model/software versions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I&lt;/b&gt;&lt;br&gt;Inspect a baseline record and demonstrate identification of every installed module." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-02" value="&lt;b&gt;COM-02 — Telemetry&lt;/b&gt;&lt;br&gt;SHALL publish timestamped navigation, energy, propulsion, environment, faults and maintenance state with units, source, quality and configuration identity.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Replay an annotated dataset; every required field has units, timestamp, provenance and a defined invalid/stale state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-03" value="&lt;b&gt;COM-03 — Local safety&lt;/b&gt;&lt;br&gt;SHALL keep emergency propulsion stop and essential local control available during WAN, cloud and AI service loss.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Inject WAN/cloud/AI loss and demonstrate local stop and control according to the approved safe-state table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-04" value="&lt;b&gt;COM-04 — Open interfaces&lt;/b&gt;&lt;br&gt;SHALL document versioned mechanical, power, data and command contracts with compatible-module rules, vendor adapters, authorized data export and component license records.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I&lt;/b&gt;&lt;br&gt;Review contracts for mounting/load limits, connectors, power limits, message schemas, authority and version compatibility." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-05" value="&lt;b&gt;COM-05 — Marine models&lt;/b&gt;&lt;br&gt;SHALL link hull, structure, propulsion, thermal, control and mission models through documented Modelica/co-simulation interfaces.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Run a reproducible coupled scenario with recorded model versions, exchanged units and time-step settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-06" value="&lt;b&gt;COM-06 — Hydrostatics&lt;/b&gt;&lt;br&gt;SHALL define displacement, draft, freeboard, trim, buoyancy and stability for each approved loading configuration.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A&lt;/b&gt;&lt;br&gt;Produce a signed loading-case analysis against criteria established before baseline approval; no inferred dimensions from the image." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-07" value="&lt;b&gt;COM-07 — Structural integrity&lt;/b&gt;&lt;br&gt;SHALL define load paths, compartmentation, penetrations, drainage, service access and corrosion/environment protection for hull, deck and module attachments.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/I&lt;/b&gt;&lt;br&gt;Review load-case calculations and inspect a compartment/penetration/access drawing against the approved design criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-08" value="&lt;b&gt;COM-08 — Energy protection&lt;/b&gt;&lt;br&gt;SHALL provide protected power distribution, emergency isolation, source/load metering and reserve prioritization for essential loads.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T/A&lt;/b&gt;&lt;br&gt;Verify the mission energy balance and inject source/bus faults; protected loads follow the approved reserve and isolation policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-09" value="&lt;b&gt;COM-09 — Human safety&lt;/b&gt;&lt;br&gt;SHALL define occupancy, access, emergency egress, fire/flooding response and human authority over automated functions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/D&lt;/b&gt;&lt;br&gt;Walk through each occupancy configuration and demonstrate egress and manual takeover against the approved hazard controls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-3" name="03 — High-level requirements 10–12">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — Common High-Level Requirements&lt;br&gt;&lt;b&gt;03 — High-level requirements 10–12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="COM-10" value="&lt;b&gt;COM-10 — Cybersecurity&lt;/b&gt;&lt;br&gt;SHALL authenticate remote commands, enforce permissions and local interlocks, record command/update provenance, and define location/occupant data minimization and retention.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Reject unauthorized/out-of-envelope commands; verify authorized actions are logged and location/occupant access and retention follow the approved privacy policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-11" value="&lt;b&gt;COM-11 — Twin verification&lt;/b&gt;&lt;br&gt;SHALL compare digital-twin state with measured/reference state and define accuracy, latency, staleness and offline recovery criteria.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Replay normal, stale-data and reconnect cases against an approved error/latency budget with a pass/fail report." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="COM-12" value="&lt;b&gt;COM-12 — Operating envelope&lt;/b&gt;&lt;br&gt;SHALL establish environmental, speed, load and maintenance limits before prototype envelope expansion.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/T&lt;/b&gt;&lt;br&gt;Approve an envelope table and staged trial entry/exit criteria; record evidence for each demonstrated condition." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
