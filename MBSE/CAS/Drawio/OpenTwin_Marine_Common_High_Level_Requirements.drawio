  <diagram id="COM-8" name="07 — Budgets and verification gates">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — Common High-Level Requirements&lt;br&gt;&lt;b&gt;07 — Budgets and verification gates&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="budgets" value="&lt;b&gt;Physical budgets — TBD&lt;/b&gt;&lt;br&gt;Dimensions, displacement/draft/freeboard, mass/CG, module payload, occupancy, structural loads and operational environment.&lt;br&gt;Resolve by CAD design and naval analysis; do not scale the illustration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="energybudget" value="&lt;b&gt;Energy / data budgets — TBD&lt;/b&gt;&lt;br&gt;Drive power, speed/endurance, usable battery energy, renewable yield, reserve, thermal loads, telemetry accuracy/latency/staleness; RV water/waste capacities.&lt;br&gt;Resolve by mission profiles and measurements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="owners" value="&lt;b&gt;Decision management&lt;/b&gt;&lt;br&gt;Assign named owners and due dates for each applicable budget. Record units, method, approved value and configuration. Acceptance criteria must be fixed before performing qualification tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="verification" value="&lt;b&gt;Verification sequence&lt;/b&gt;&lt;br&gt;Requirements review → CAD packaging/load cases → naval/energy analysis → model validation → SIL/HIL faults → subsystem bench → controlled prototype demonstration.&lt;br&gt;CSV records method and acceptance per requirement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;Baseline exit&lt;/b&gt;&lt;br&gt;Approve CONOPS/configuration, resolve critical budgets, define mode/fault table, approve hazards/interfaces, allocate all applicable COM requirements and establish evidence records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;Evidence status&lt;/b&gt;&lt;br&gt;This refactor establishes requirements traceability only. CAD illustrations, tool choices and an attractive dashboard do not constitute hydrostatic, structural, performance or compliance evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>