        <mxCell id="propulsion" value="&lt;b&gt;Marine propulsion&lt;/b&gt;&lt;br&gt;Replaceable drive, steering, isolation and condition feedback&lt;br&gt;&lt;br&gt;Design allocation: " style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="energy" value="&lt;b&gt;Energy / utilities&lt;/b&gt;&lt;br&gt;Storage, conversion, protection, hotel loads and optional sources&lt;br&gt;&lt;br&gt;Design allocation: COM-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
