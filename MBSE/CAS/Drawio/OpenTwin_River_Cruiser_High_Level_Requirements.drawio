        <mxCell id="mission" value="&lt;b&gt;Mission / habitation&lt;/b&gt;&lt;br&gt;Module mounting, occupancy, handling and service access&lt;br&gt;&lt;br&gt;Design allocation: RIV-02, RIV-05, RIV-06, RIV-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;Local navigation / safety&lt;/b&gt;&lt;br&gt;Sensors, HMI, operator authority, mode guards and safe stop&lt;br&gt;&lt;br&gt;Design allocation: RIV-04, COM-03, COM-09, COM-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
