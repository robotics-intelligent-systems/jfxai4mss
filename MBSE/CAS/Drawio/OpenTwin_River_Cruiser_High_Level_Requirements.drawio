  <diagram id="RIV-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — River Cruiser Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;MBSE/CAD/river-cruiser-ship-concept.jpg&lt;br&gt;&lt;br&gt;Illustrated callouts are concept evidence; dimensions and performance require design/analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Baseline interpretation&lt;/b&gt;&lt;br&gt;River hull, multiple passenger decks, navigation, modular energy and mission payloads are illustrated. No amphibious land mobility or solar array is established." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Requirements status&lt;/b&gt;&lt;br&gt;Proposed high-level requirements. Named owners are proposed engineering roles, not assigned people. Acceptance budgets and dates require project assignment. No completion/certification claim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission / stakeholders&lt;/b&gt;&lt;br&gt;Operator, occupants/crew, payload team, naval architect, controls/energy engineers and maintainers.&lt;br&gt;Scenario: configure → inspect → operate under local authority → dock/recover → maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="shared" value="&lt;b&gt;Shared requirements allocation&lt;/b&gt;&lt;br&gt;Allocate COM-01 through COM-12 from OpenTwin_Marine_Common_High_Level_Requirements.drawio alongside this asset specification.&lt;br&gt;Traceability register: docs/requirements/cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Boundary / exclusions&lt;/b&gt;&lt;br&gt;Concept requirements and interfaces for MBSE/CAD/simulation. Numerical budgets, production geometry and verification evidence are unresolved. Unillustrated variants require a separate configuration decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="RIV-2" name="02 — High-level requirements 1–8">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Marine — River Cruiser Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="RIV-01" value="&lt;b&gt;RIV-01 — River hull and decks&lt;/b&gt;&lt;br&gt;SHALL provide the illustrated river-vessel hull and multiple accommodation decks with controlled loading, access and structural load paths.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/I&lt;/b&gt;&lt;br&gt;Inspect a deck arrangement and analyze hull/deck loads and stability for each approved passenger/module configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-02" value="&lt;b&gt;RIV-02 — Passenger operation&lt;/b&gt;&lt;br&gt;SHALL define cabins/common areas, configurable passenger modules, occupancy, accessible boarding and emergency egress.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/D&lt;/b&gt;&lt;br&gt;Demonstrate boarding and egress against an approved arrangement and occupancy plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-03" value="&lt;b&gt;RIV-03 — Energy and drive&lt;/b&gt;&lt;br&gt;SHALL define modular battery banks and an electric base drive with separately assessed hybrid/hydrogen alternatives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/T&lt;/b&gt;&lt;br&gt;Analyze propulsion and hotel demand for a river mission; demonstrate isolation and reserve control for the selected configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-04" value="&lt;b&gt;RIV-04 — River navigation&lt;/b&gt;&lt;br&gt;SHALL provide local navigation/HMI and supervised autonomy interfaces using GNSS/AIS, selected perception and environmental sensors.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Replay current, shallow-water, docking and sensor-loss cases within the approved envelope and verify manual takeover." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-05" value="&lt;b&gt;RIV-05 — Interchangeable missions&lt;/b&gt;&lt;br&gt;SHALL define passenger, cargo, research, surveillance, environmental and emergency module interfaces with retained loading records.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/D&lt;/b&gt;&lt;br&gt;Review mounting, handling, power/data and mass/CG contracts; demonstrate one approved module substitution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-06" value="&lt;b&gt;RIV-06 — ROV/AUV option&lt;/b&gt;&lt;br&gt;SHALL define an optional ROV/AUV launch, recovery and data interface before enabling research deployment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/D&lt;/b&gt;&lt;br&gt;Analyze handling loads and exclusion zones; demonstrate recovery and emergency interruption for the selected equipment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-07" value="&lt;b&gt;RIV-07 — River environment&lt;/b&gt;&lt;br&gt;SHALL assess draft/under-keel clearance, current, wind, bank interaction and wave effects for the intended waterway and loading cases.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/T&lt;/b&gt;&lt;br&gt;Produce an approved waterway envelope and compare maneuvering predictions with staged controlled trials." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="RIV-08" value="&lt;b&gt;RIV-08 — Hotel loads&lt;/b&gt;&lt;br&gt;SHALL include accommodation HVAC, lighting, water/waste and passenger services in power, safety and maintenance budgets.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/I&lt;/b&gt;&lt;br&gt;Review service arrangements and calculate hotel/essential-load budgets for the approved occupancy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
