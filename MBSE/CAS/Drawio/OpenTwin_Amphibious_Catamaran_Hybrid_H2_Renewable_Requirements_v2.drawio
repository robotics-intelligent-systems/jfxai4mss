<mxfile host="app.diagrams.net" modified="2026-09-09T03:52:00.100967+00:00" agent="ChatGPT" version="31.4.2" type="device">
<diagram id="d935f2bc3ad0" name="01 - Scope &amp; CONOPS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious Catamaran — High-Level Requirements Engineering — Hybrid H₂ / Renewable Energy Revision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;System Concept&lt;/b&gt;&lt;br&gt;Modular amphibious catamaran capable of controlled operation on water and limited self-deployment on land for launch, recovery, beaching, ramps and short-distance low-speed relocation. The platform integrates marine propulsion, amphibious landing gear/wheel modules, mission payloads, onboard compute, telemetry and an OpenTwin digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="270" as="geometry" /></mxCell><mxCell id="use" value="&lt;b&gt;Primary Use Cases&lt;/b&gt;&lt;br&gt;• Coastal / river research&lt;br&gt;• Tourism / recreation concept&lt;br&gt;• Environmental monitoring&lt;br&gt;• Inspection / survey missions&lt;br&gt;• Emergency logistics / evacuation support&lt;br&gt;• Autonomous surface vehicle research&lt;br&gt;• Mobile sensor / robotics platform" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="585" y="140" width="430" height="270" as="geometry" /></mxCell><mxCell id="stake" value="&lt;b&gt;Stakeholders&lt;/b&gt;&lt;br&gt;Operator / skipper&lt;br&gt;Passengers / mission crew&lt;br&gt;Naval architect&lt;br&gt;Mechanical / amphibious-systems engineer&lt;br&gt;Electrical / propulsion engineer&lt;br&gt;ROS 2 / autonomy engineer&lt;br&gt;OpenTwin / simulation team&lt;br&gt;Maintenance and regulatory authorities" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1100" y="140" width="430" height="270" as="geometry" /></mxCell><mxCell id="bound" value="&lt;b&gt;System Boundary&lt;/b&gt;&lt;br&gt;IN: twin hulls, bridging structure, deck/cabin, buoyancy, steering, marine propulsion, amphibious wheel/landing modules, energy storage/distribution, communications, sensing, safety systems, mission payload interfaces, OpenTwin gateway.&lt;br&gt;&lt;br&gt;OUT: certified production scantlings, detailed class approval, public-road homologation and commercial passenger-vessel certification." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="490" width="700" height="300" as="geometry" /></mxCell><mxCell id="modes" value="&lt;b&gt;Operational Modes&lt;/b&gt;&lt;br&gt;SAFE / OFF&lt;br&gt;WATER NAVIGATION&lt;br&gt;LOW-SPEED LAND MOBILITY&lt;br&gt;WATER→LAND TRANSITION&lt;br&gt;LAND→WATER TRANSITION&lt;br&gt;BEACHED / PARKED&lt;br&gt;AUTONOMOUS / REMOTE-SUPERVISED&lt;br&gt;DEGRADED / RECOVERY&lt;br&gt;MAINTENANCE / DIAGNOSTIC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="490" width="700" height="300" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;Engineering Gate&lt;/b&gt;&lt;br&gt;Progression beyond concept requires naval-architecture validation of hydrostatics, stability, resistance and structure; verification of amphibious wheel/landing loads; propulsion and electrical safety; recovery/egress analysis; and mapping to jurisdiction-specific marine and land-vehicle requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="850" width="1100" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="2c0a150e41d1" name="02 - Functional Requirements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="FR-01" value="&lt;b&gt;FR-01 — Water Navigation&lt;/b&gt;&lt;br&gt;Provide controlled marine propulsion, steering and maneuvering within the validated sea/river operating envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-02" value="&lt;b&gt;FR-02 — Land Mobility&lt;/b&gt;&lt;br&gt;Provide limited low-speed self-propelled or powered-wheel movement on defined ramps, beaches and firm terrain." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-03" value="&lt;b&gt;FR-03 — Transition&lt;/b&gt;&lt;br&gt;Support defined water↔land transition sequences with propulsion and landing-gear interlocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-04" value="&lt;b&gt;FR-04 — Buoyancy&lt;/b&gt;&lt;br&gt;Maintain positive buoyancy and required reserve buoyancy for each approved loading condition." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-05" value="&lt;b&gt;FR-05 — Stability&lt;/b&gt;&lt;br&gt;Maintain validated intact stability, trim and freeboard throughout water operation and transition states." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-06" value="&lt;b&gt;FR-06 — Amphibious Gear&lt;/b&gt;&lt;br&gt;Deploy/retract or otherwise manage wheel/landing modules without compromising hull integrity or unsafe motion." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-07" value="&lt;b&gt;FR-07 — Payload&lt;/b&gt;&lt;br&gt;Provide modular interfaces for passenger, sensor, research, rescue, cargo or autonomous mission modules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-08" value="&lt;b&gt;FR-08 — Energy&lt;/b&gt;&lt;br&gt;Provide protected energy storage/distribution supporting propulsion, hotel loads, sensors, compute and safety systems." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-09" value="&lt;b&gt;FR-09 — Navigation&lt;/b&gt;&lt;br&gt;Provide heading, position, speed and attitude information appropriate to manual and optional autonomous operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-10" value="&lt;b&gt;FR-10 — Communications&lt;/b&gt;&lt;br&gt;Provide local vessel network plus remote telemetry suitable for supervised operations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-11" value="&lt;b&gt;FR-11 — OpenTwin Telemetry&lt;/b&gt;&lt;br&gt;Publish propulsion, energy, navigation, stability-related, amphibious-gear and maintenance state to the digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-12" value="&lt;b&gt;FR-12 — Fail-Safe Operation&lt;/b&gt;&lt;br&gt;Essential local steering, propulsion stop and safety functions shall not depend on remote/cloud connectivity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="57aab80cf7f5" name="03 - NFR &amp; Constraints"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Non-Functional Requirements &amp; Constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;NFR-01 Marine Safety&lt;/b&gt;&lt;br&gt;Hull/deck/egress arrangements shall address foreseeable flooding, loss of propulsion, grounding and passenger/crew hazards." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;NFR-02 Structural&lt;/b&gt;&lt;br&gt;Hull, bridge deck, cross-structure, amphibious gear and payload mounts shall be verified against marine, beaching, ramp and land-mobility loads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;NFR-03 Stability&lt;/b&gt;&lt;br&gt;Intact stability, trim, freeboard and loading limits shall be defined and verified for each approved operating configuration." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;NFR-04 Environmental&lt;/b&gt;&lt;br&gt;Critical systems shall tolerate salt/fresh water, spray, corrosion, vibration, temperature, humidity, mud and limited immersion as applicable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;NFR-05 Maintainability&lt;/b&gt;&lt;br&gt;Thrusters, wheels/gear, bearings, seals, bilge systems, batteries, electronics and sensors shall be inspectable/serviceable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;NFR-06 Human Factors&lt;/b&gt;&lt;br&gt;Controls and mode annunciation shall clearly distinguish WATER, LAND and TRANSITION states." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;NFR-07 Modularity&lt;/b&gt;&lt;br&gt;Propulsion, power, compute, sensors and payload systems should use documented replaceable interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;NFR-08 Cybersecurity&lt;/b&gt;&lt;br&gt;Remote commands shall be authenticated, authorized, logged and bounded by local safety interlocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;NFR-09 Resilience&lt;/b&gt;&lt;br&gt;Loss of GNSS, WAN, AI/autonomy or digital-twin synchronization shall not disable essential local vessel control." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;NFR-10 Data Provenance&lt;/b&gt;&lt;br&gt;Engineering telemetry shall preserve source, timestamp, quality, configuration and model/software versions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;NFR-11 Sustainability&lt;/b&gt;&lt;br&gt;Favor energy-efficient propulsion, repairable modules, recyclable materials and optional renewable generation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;NFR-12 Compliance&lt;/b&gt;&lt;br&gt;Final design shall map requirements to applicable marine, electrical, passenger, autonomous-vessel and land-mobility regulations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="9bd5ebbe0e0b" name="04 - Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious Catamaran — Reference Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="hull" value="&lt;b&gt;CATAMARAN PLATFORM&lt;/b&gt;&lt;br&gt;Twin hulls&lt;br&gt;Bridge deck&lt;br&gt;Superstructure/cabin&lt;br&gt;Compartments&lt;br&gt;Bilge/drainage&lt;br&gt;Deck/payload mounts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="55" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="amph" value="&lt;b&gt;AMPHIBIOUS MOBILITY&lt;/b&gt;&lt;br&gt;Wheel/landing modules&lt;br&gt;Steering/braking&lt;br&gt;Deployment mechanism&lt;br&gt;Beach/ramp loads&lt;br&gt;Ground clearance&lt;br&gt;Transition interlocks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="385" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="prop" value="&lt;b&gt;MARINE PROPULSION &amp; ENERGY&lt;/b&gt;&lt;br&gt;Electric/other modular thrusters&lt;br&gt;Steering vector / differential thrust&lt;br&gt;Energy storage&lt;br&gt;Power distribution&lt;br&gt;Cooling&lt;br&gt;Emergency isolation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="715" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="sens" value="&lt;b&gt;SENSORS / NAVIGATION&lt;/b&gt;&lt;br&gt;GNSS&lt;br&gt;IMU / heading&lt;br&gt;Depth / water sensing&lt;br&gt;Cameras / LiDAR optional&lt;br&gt;Weather/environment&lt;br&gt;Hull/gear health" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1045" y="155" width="280" height="280" as="geometry" /></mxCell><mxCell id="edge" value="&lt;b&gt;OPENTWIN EDGE&lt;/b&gt;&lt;br&gt;ROS 2 / service adapters&lt;br&gt;State estimator&lt;br&gt;Mode manager&lt;br&gt;Telemetry/event buffer&lt;br&gt;Health monitoring&lt;br&gt;Offline-first control" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1045" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="twin" value="&lt;b&gt;DIGITAL TWIN&lt;/b&gt;&lt;br&gt;Vessel Twin&lt;br&gt;Hull/Stability Twin&lt;br&gt;Propulsion Twin&lt;br&gt;Energy Twin&lt;br&gt;Amphibious Gear Twin&lt;br&gt;Mission Twin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="715" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="sim" value="&lt;b&gt;MARINE SIMULATION&lt;/b&gt;&lt;br&gt;MSS / Modelica reference&lt;br&gt;Co-simulation&lt;br&gt;Ship maneuvering&lt;br&gt;Wave/current environment&lt;br&gt;Hydrostatics/stability&lt;br&gt;Propulsion analysis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="385" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="auto" value="&lt;b&gt;AI / AUTONOMY&lt;/b&gt;&lt;br&gt;Route planning&lt;br&gt;COLAV research&lt;br&gt;Obstacle detection&lt;br&gt;Docking/beaching assistance&lt;br&gt;Energy optimization&lt;br&gt;Predictive maintenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="55" y="570" width="280" height="260" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="hull" target="amph"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="amph" target="prop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="prop" target="sens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sens" target="edge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="edge" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sim" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="auto" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="b14539ffc86f" name="05 - Modes &amp; Safety"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Operational Modes &amp; Amphibious Transition Interlocks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="safe" value="&lt;b&gt;SAFE / OFF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="80" y="400" width="250" height="105" as="geometry" /></mxCell><mxCell id="water" value="&lt;b&gt;WATER NAVIGATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="380" y="170" width="250" height="105" as="geometry" /></mxCell><mxCell id="wl" value="&lt;b&gt;WATER → LAND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="730" y="170" width="250" height="105" as="geometry" /></mxCell><mxCell id="land" value="&lt;b&gt;LAND MOBILITY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1110" y="400" width="250" height="105" as="geometry" /></mxCell><mxCell id="lw" value="&lt;b&gt;LAND → WATER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="730" y="625" width="250" height="105" as="geometry" /></mxCell><mxCell id="beach" value="&lt;b&gt;BEACHED / PARKED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="380" y="625" width="250" height="105" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;High-Level Transition Guards&lt;/b&gt;&lt;br&gt;• Wheel/landing deployment shall occur only within validated speed, water-depth, trim and load conditions.&lt;br&gt;• Marine and land propulsion commands shall be mutually constrained to prevent incompatible thrust states.&lt;br&gt;• Critical flooding, stability, steering, brake, gear-position, energy or control faults shall inhibit unsafe transitions.&lt;br&gt;• Beaching/ramp operation shall use a defined low-speed mode with reduced propulsion limits.&lt;br&gt;• Exact thresholds remain TBD until hydrostatic, structural, propulsion and prototype testing are complete." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="350" y="830" width="950" height="170" as="geometry" /></mxCell><mxCell id="a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="safe" target="water"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="water" target="wl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="wl" target="land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="lw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="lw" target="water"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="beach"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="beach" target="safe"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="0105725c6f29" name="06 - Naval Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Naval Architecture Requirements — Hydrostatics, Stability &amp; Structure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="nav0" value="&lt;b&gt;NAV-01 Hydrostatics&lt;/b&gt;&lt;br&gt;Define displacement, draft, waterplane, trim and freeboard for lightship, nominal mission and maximum approved load cases." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav1" value="&lt;b&gt;NAV-02 Intact Stability&lt;/b&gt;&lt;br&gt;Generate GZ/righting-arm or equivalent stability evidence appropriate to the vessel category and concept maturity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="120" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav2" value="&lt;b&gt;NAV-03 Compartmentation&lt;/b&gt;&lt;br&gt;Define watertight/buoyant volumes and flooding assumptions; identify critical penetrations and bilge/drainage strategy." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="305" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav3" value="&lt;b&gt;NAV-04 Catamaran Structure&lt;/b&gt;&lt;br&gt;Verify demi-hulls, bridge deck, cross-structure and local attachment zones for water, slamming, payload and amphibious loads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="305" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav4" value="&lt;b&gt;NAV-05 Resistance&lt;/b&gt;&lt;br&gt;Estimate hull resistance over the intended water-speed envelope and account for catamaran interference effects." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="490" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav5" value="&lt;b&gt;NAV-06 Propulsion&lt;/b&gt;&lt;br&gt;Size marine propulsion against resistance, maneuvering, wind/current margin and low-speed rescue/recovery requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="490" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav6" value="&lt;b&gt;NAV-07 Beaching / Ground Loads&lt;/b&gt;&lt;br&gt;Analyze local bottom/hull/gear loads during ramp, beach and low-speed land operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="675" width="690" height="145" as="geometry" /></mxCell><mxCell id="nav7" value="&lt;b&gt;NAV-08 Weight Management&lt;/b&gt;&lt;br&gt;Maintain controlled lightship, payload, consumables, battery/energy and growth-margin budgets with CG tracking." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="675" width="690" height="145" as="geometry" /></mxCell><mxCell id="ref" value="&lt;b&gt;jfxai4mss simulation alignment&lt;/b&gt;&lt;br&gt;Candidate engineering references in the repository include Marine Systems Simulator (MSS), Modelica-based naval simulation, co-simulation frameworks, ship maneuvering simulation, wave/hydrodynamics tools, OpenProp and ROS 2 marine integration. Selection of a tool does not by itself establish verification or certification." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="250" y="890" width="1100" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="7cbf4a3d5bea" name="07 - Interfaces &amp; Twin Data"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Interfaces &amp; OpenTwin Data Model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="i0" value="&lt;b&gt;IF-01 Structural&lt;/b&gt;&lt;br&gt;Demi-hulls ↔ bridge deck ↔ cabin/deck modules ↔ amphibious gear ↔ payload mounts." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i1" value="&lt;b&gt;IF-02 Amphibious Gear&lt;/b&gt;&lt;br&gt;Deployment actuators, mechanical locks, position sensing, wheel drive/brake/steering interfaces and load transfer." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i2" value="&lt;b&gt;IF-03 Marine Propulsion&lt;/b&gt;&lt;br&gt;Thruster/motor/steering interfaces, protected power, cooling, fault status and emergency isolation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i3" value="&lt;b&gt;IF-04 Electrical&lt;/b&gt;&lt;br&gt;Energy storage, DC buses, optional shore/renewable charging, protection, low-voltage safety loads and compute." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i4" value="&lt;b&gt;IF-05 Data&lt;/b&gt;&lt;br&gt;ROS 2/service APIs, marine/vehicle bus adapters, MQTT/DDS optional, timestamped telemetry and local buffering." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="i5" value="&lt;b&gt;IF-06 Human / Mission&lt;/b&gt;&lt;br&gt;Helm/HMI, emergency stop, boarding, egress, payload controls, maintenance access and manual recovery." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="schema" value="&lt;b&gt;Minimum OpenTwin Amphibious Catamaran State&lt;/b&gt;&lt;br&gt;asset_id · configuration_id · operating_mode · position · heading · water_speed · land_speed · attitude · draft/trim estimates · propulsion_state · amphibious_gear_state · energy_state · compartment/ingress alarms · environment state · payload state · communications status · faults · maintenance_due · software/model versions · timestamp · provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="270" y="770" width="1060" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="9b1b1ca22cfa" name="08 - Simulation &amp; AI"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Simulation, Co-Simulation, AI &amp; Autonomous Marine Research" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry" /></mxCell><mxCell id="mbse" value="&lt;b&gt;MBSE / Capella&lt;/b&gt;&lt;br&gt;Stakeholder needs&lt;br&gt;CONOPS&lt;br&gt;Operational scenarios&lt;br&gt;Logical/physical architecture&lt;br&gt;Requirements traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="160" width="270" height="250" as="geometry" /></mxCell><mxCell id="physics" value="&lt;b&gt;Marine Physics&lt;/b&gt;&lt;br&gt;MSS / Modelica reference&lt;br&gt;6-DOF maneuvering&lt;br&gt;Hydrostatics&lt;br&gt;Resistance/propulsion&lt;br&gt;Wind/wave/current loads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="370" y="160" width="270" height="250" as="geometry" /></mxCell><mxCell id="cosim" value="&lt;b&gt;Co-Simulation&lt;/b&gt;&lt;br&gt;OSP/libcosim&lt;br&gt;DCP-style interfaces&lt;br&gt;Control + vessel dynamics&lt;br&gt;Energy subsystem&lt;br&gt;Amphibious transition model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="680" y="160" width="270" height="250" as="geometry" /></mxCell><mxCell id="ros" value="&lt;b&gt;ROS 2 / Marine Simulation&lt;/b&gt;&lt;br&gt;Navigation&lt;br&gt;Sensors&lt;br&gt;Telemetry&lt;br&gt;Vehicle control&lt;br&gt;Scenario replay&lt;br&gt;HIL interfaces" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="990" y="160" width="270" height="250" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;AI / Autonomy&lt;/b&gt;&lt;br&gt;COLAV decision support&lt;br&gt;Perception&lt;br&gt;Route optimization&lt;br&gt;Dock/beach assistance&lt;br&gt;Anomaly detection&lt;br&gt;Predictive maintenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1290" y="160" width="250" height="250" as="geometry" /></mxCell><mxCell id="chain" value="&lt;b&gt;Verification Chain&lt;/b&gt;&lt;br&gt;Requirements → hydrostatics/stability → physics models → co-simulation → autonomy/control SIL → HIL where applicable → subsystem rigs → controlled water prototype → controlled land/transition prototype → supervised mission demonstrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="575" width="1100" height="160" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Repository alignment:&lt;/b&gt; jfxai4mss is an AI-powered marine systems simulation platform and technology compendium covering marine control/simulation, digital twins, ROS 2 integration, co-simulation, underwater/marine robotics and naval design references. This document uses that stack as engineering infrastructure for an OpenTwin amphibious catamaran concept." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="250" y="810" width="1100" height="150" as="geometry" /></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mbse" target="physics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="physics" target="cosim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="cosim" target="ros"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ros" target="ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ai" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="6058c9ac5dd3" name="09 - V&amp;V Traceability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Verification, Validation &amp; Requirements Traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="v0" value="&lt;b&gt;V-01 Inspection&lt;/b&gt;&lt;br&gt;Compartments, penetrations, guards, egress, payload retention, amphibious gear, markings and serviceability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="690" height="130" as="geometry" /></mxCell><mxCell id="v1" value="&lt;b&gt;V-02 Analysis&lt;/b&gt;&lt;br&gt;Weight/CG, hydrostatics, intact stability, structural loads, resistance, propulsion, electrical/thermal and beach/ramp loads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="120" width="690" height="130" as="geometry" /></mxCell><mxCell id="v2" value="&lt;b&gt;V-03 Simulation&lt;/b&gt;&lt;br&gt;Maneuvering, wind/current/wave cases, transition modes, control logic, degraded states and autonomy scenarios." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="290" width="690" height="130" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;V-04 Bench/HIL&lt;/b&gt;&lt;br&gt;Energy/power, controls, sensors, communications, propulsion interlocks, gear actuation and emergency safe-state logic." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="290" width="690" height="130" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;V-05 Static Water Test&lt;/b&gt;&lt;br&gt;Progressive flotation, trim, compartment/ingress monitoring and stability checks in a controlled environment." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="460" width="690" height="130" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;V-06 Controlled Water Trial&lt;/b&gt;&lt;br&gt;Low-speed maneuvering, propulsion, steering, energy and communications before envelope expansion." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="460" width="690" height="130" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;V-07 Controlled Land Test&lt;/b&gt;&lt;br&gt;Low-speed wheel/gear mobility, braking/steering, structural deflection and thermal behavior on a closed site." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="630" width="690" height="130" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;V-08 Transition Test&lt;/b&gt;&lt;br&gt;Ramp/beach water↔land transitions after independent water and land entry criteria are satisfied." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="630" width="690" height="130" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;V-09 OpenTwin V&amp;V&lt;/b&gt;&lt;br&gt;Twin state consistency, latency, configuration traceability, event chronology, offline recovery and model provenance." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="800" width="690" height="130" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;V-10 Compliance Review&lt;/b&gt;&lt;br&gt;Map final configuration to applicable marine, passenger, electrical, autonomy and land-mobility regulations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="800" width="690" height="130" as="geometry" /></mxCell><mxCell id="trace" value="&lt;b&gt;Traceability Rule:&lt;/b&gt; Stakeholder Need → System Requirement → Naval/Amphibious/Propulsion/Software Requirement → Design Element → Verification Method → Evidence → Configuration Baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="220" y="925" width="1160" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="debd6a693db2" name="10 - MVP &amp; Roadmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="MVP Technology Demonstrator &amp; Engineering Roadmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="mvp" value="&lt;b&gt;MVP / Technology Demonstrator&lt;/b&gt;&lt;br&gt;• Simplified twin-hull platform&lt;br&gt;• Low-speed marine propulsion&lt;br&gt;• Limited low-speed amphibious wheel/landing system&lt;br&gt;• Manual helm and transition controls&lt;br&gt;• Basic GNSS/IMU and hull/gear sensing&lt;br&gt;• Energy and propulsion telemetry&lt;br&gt;• Ingress/bilge monitoring&lt;br&gt;• Local ROS 2/OpenTwin gateway&lt;br&gt;• Digital Twin dashboard&lt;br&gt;• Controlled water/land transition test instrumentation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="580" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1 — Requirements / MBSE&lt;/b&gt;&lt;br&gt;CONOPS&lt;br&gt;Mission profiles&lt;br&gt;Operational envelope&lt;br&gt;Hazards&lt;br&gt;Loading cases&lt;br&gt;Requirements baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="140" width="380" height="220" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2 — Naval / Digital Engineering&lt;/b&gt;&lt;br&gt;CAD packaging&lt;br&gt;Hydrostatics&lt;br&gt;Stability&lt;br&gt;Structure&lt;br&gt;Resistance/propulsion&lt;br&gt;Amphibious loads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="140" width="380" height="220" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3 — Simulation / OpenTwin&lt;/b&gt;&lt;br&gt;MSS/Modelica models&lt;br&gt;ROS 2 simulation&lt;br&gt;Co-simulation&lt;br&gt;Digital twin&lt;br&gt;Scenario library&lt;br&gt;AI experiments" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="440" width="380" height="220" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4 — Controlled Prototype&lt;/b&gt;&lt;br&gt;Subsystem rigs&lt;br&gt;Static water test&lt;br&gt;Water trial&lt;br&gt;Land mobility test&lt;br&gt;Transition test&lt;br&gt;Traceability closure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="440" width="380" height="220" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;Release Gate&lt;/b&gt;&lt;br&gt;No passenger/commercial operation, public-road use or navigable-water deployment until applicable naval architecture, stability, structural, electrical, propulsion, amphibious-mobility, autonomy/cybersecurity and jurisdiction-specific requirements have been independently reviewed and satisfied." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="805" width="1000" height="140" as="geometry" /></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p4" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="7cb8264f1650" name="11 - Hybrid H2 Renewable Energy"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Hybrid Hydrogen-Renewable Propulsion &amp; Energy Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="solar" value="&lt;b&gt;SOLAR GENERATION&lt;/b&gt;&lt;br&gt;Roof/deck photovoltaic arrays&lt;br&gt;MPPT / protected DC interface&lt;br&gt;Energy telemetry&lt;br&gt;Structural/wind-load mounting requirements&lt;br&gt;Marine corrosion protection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="230" as="geometry" /></mxCell><mxCell id="wind" value="&lt;b&gt;WIND GENERATOR&lt;/b&gt;&lt;br&gt;Compact marine-rated wind turbine&lt;br&gt;Deploy/stow or guarded mounting strategy&lt;br&gt;Rectification / charge control&lt;br&gt;Overspeed / storm protection&lt;br&gt;Vibration and acoustic constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="280" height="230" as="geometry" /></mxCell><mxCell id="ely" value="&lt;b&gt;ONBOARD H₂ GENERATOR&lt;/b&gt;&lt;br&gt;Electrolyzer using approved water feed and available electrical energy&lt;br&gt;Hydrogen quality monitoring&lt;br&gt;Drying / conditioning as required&lt;br&gt;Automatic shutdown on abnormal conditions&lt;br&gt;Operation prioritized when renewable surplus is available" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="300" height="230" as="geometry" /></mxCell><mxCell id="storage" value="&lt;b&gt;HYDROGEN STORAGE &amp; SUPPLY&lt;/b&gt;&lt;br&gt;Rated storage vessels / modules&lt;br&gt;Isolation and pressure regulation&lt;br&gt;Leak detection / ventilation&lt;br&gt;Protected refueling / service interface&lt;br&gt;Local emergency shutoff" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="280" height="230" as="geometry" /></mxCell><mxCell id="turbine" value="&lt;b&gt;H₂ GAS-TURBINE GENERATOR SET&lt;/b&gt;&lt;br&gt;Hydrogen-fueled turbine driving an electrical generator&lt;br&gt;Power-conditioning interface to the vessel DC bus&lt;br&gt;Local start/stop and emergency shutdown&lt;br&gt;Thermal, exhaust and enclosure management&lt;br&gt;Condition monitoring" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="280" height="250" as="geometry" /></mxCell><mxCell id="bus" value="&lt;b&gt;HYBRID DC ENERGY BUS&lt;/b&gt;&lt;br&gt;Battery / buffer storage&lt;br&gt;Solar + wind + turbine-generator inputs&lt;br&gt;Protected distribution&lt;br&gt;Load shedding&lt;br&gt;Bidirectional energy metering&lt;br&gt;Black-start / safe shutdown strategy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="300" height="250" as="geometry" /></mxCell><mxCell id="prop" value="&lt;b&gt;ELECTRIC PROPULSION&lt;/b&gt;&lt;br&gt;Marine electric thrusters / waterjets as selected&lt;br&gt;Electric amphibious wheel drive where applicable&lt;br&gt;Inverters / motor controllers&lt;br&gt;Regenerative opportunities where technically valid&lt;br&gt;Propulsion priority managed by mode controller" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="280" height="250" as="geometry" /></mxCell><mxCell id="hotel" value="&lt;b&gt;HOTEL / MISSION LOADS&lt;/b&gt;&lt;br&gt;Navigation and compute&lt;br&gt;Lighting / HVAC&lt;br&gt;Sensors / communications&lt;br&gt;Mission payloads&lt;br&gt;Safety-critical low-voltage loads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="280" height="250" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Energy-System Principle&lt;/b&gt;&lt;br&gt;The onboard electrolyzer is an energy-storage pathway, not an independent energy source. Hydrogen production consumes electrical energy and shall be scheduled against available renewable/shore surplus, battery state and mission reserves. The architecture shall preserve explicit energy-balance accounting and prohibit control assumptions equivalent to perpetual self-generation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="860" width="1100" height="150" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="solar" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wind" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bus" target="ely"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ely" target="storage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="storage" target="turbine"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="turbine" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bus" target="prop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bus" target="hotel"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="3f0a4675e6b5" name="12 - Hybrid Energy Requirements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Hybrid Propulsion Requirements — H₂ Turbine, Electrolyzer, Wind &amp; Solar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="25" width="1260" height="70" as="geometry" /></mxCell><mxCell id="req1" value="&lt;b&gt;HYB-01 — Energy Management&lt;/b&gt;&lt;br&gt;A supervisory energy-management controller shall coordinate solar generation, wind generation, battery state, electrolyzer operation, hydrogen inventory, turbine-generator output, propulsion demand and hotel/mission loads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="465" height="165" as="geometry" /></mxCell><mxCell id="req2" value="&lt;b&gt;HYB-02 — H₂ Turbine Generator&lt;/b&gt;&lt;br&gt;The hydrogen-fueled turbine-generator shall operate only within validated fuel-pressure, ventilation, thermal, electrical and enclosure conditions, with local overspeed/overtemperature/fault shutdown independent of remote services." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="130" width="465" height="165" as="geometry" /></mxCell><mxCell id="req3" value="&lt;b&gt;HYB-03 — Solar&lt;/b&gt;&lt;br&gt;Photovoltaic generation shall use protected marine-rated power conversion, isolation and monitoring, and its mounting shall be assessed for wind, vibration, shading, corrosion and maintenance access." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="130" width="465" height="165" as="geometry" /></mxCell><mxCell id="req4" value="&lt;b&gt;HYB-04 — Wind Generation&lt;/b&gt;&lt;br&gt;The wind generator shall include guarded installation, safe maintenance access, overspeed/storm response, deploy/stow strategy if required, and vibration/noise limits compatible with vessel operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="465" height="175" as="geometry" /></mxCell><mxCell id="req5" value="&lt;b&gt;HYB-05 — Electrolyzer / H₂ Generator&lt;/b&gt;&lt;br&gt;The onboard hydrogen generator shall operate only under validated water-quality, ventilation, pressure, electrical and thermal conditions and shall automatically isolate on leak, abnormal pressure, low ventilation or safety-system faults." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="345" width="465" height="175" as="geometry" /></mxCell><mxCell id="req6" value="&lt;b&gt;HYB-06 — Hydrogen Storage&lt;/b&gt;&lt;br&gt;Hydrogen storage and delivery components shall be purpose-designed, rated and protected; the design shall provide isolation, pressure regulation, leak detection, ventilation, segregation from ignition sources and emergency shutoff." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="345" width="465" height="175" as="geometry" /></mxCell><mxCell id="req7" value="&lt;b&gt;HYB-07 — Mission Reserve&lt;/b&gt;&lt;br&gt;Energy management shall preserve a configurable minimum reserve for steering, communications, bilge/ingress control, navigation, emergency lighting and controlled return/recovery." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="465" height="175" as="geometry" /></mxCell><mxCell id="req8" value="&lt;b&gt;HYB-08 — Mode Priorities&lt;/b&gt;&lt;br&gt;WATER NAVIGATION shall prioritize marine propulsion; LAND MOBILITY shall prioritize amphibious wheel/gear loads; BEACHED/PARKED mode may prioritize renewable charging and hydrogen production when safe and energetically justified." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="570" width="465" height="175" as="geometry" /></mxCell><mxCell id="req9" value="&lt;b&gt;HYB-09 — OpenTwin Telemetry&lt;/b&gt;&lt;br&gt;The Digital Twin shall include solar/wind output, battery SOC/SOH, DC bus state, electrolyzer state, H₂ inventory/pressure, leak-detector state, turbine-generator power/temperature, propulsion demand, reserve margin, faults and maintenance state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="570" width="465" height="175" as="geometry" /></mxCell><mxCell id="vv" value="&lt;b&gt;Verification &amp; Safety Gates&lt;/b&gt;&lt;br&gt;Analysis: energy balance, mission endurance, hydrogen inventory, ventilation, thermal/exhaust loads, electrical fault energy, mass/CG and stability impact of turbine, storage, electrolyzer, solar and wind systems.&lt;br&gt;Bench/HIL: EMS logic, source switching, isolation, leak detection, overspeed/thermal shutdown, DC-bus protection and load shedding.&lt;br&gt;Prototype: renewable charging tests, controlled electrolyzer tests, turbine-generator tests, integrated propulsion/energy trials and emergency shutdown validation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="260" y="820" width="1080" height="205" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>