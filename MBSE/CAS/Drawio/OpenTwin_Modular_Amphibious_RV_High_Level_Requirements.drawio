        <mxCell id="edge-0" value="protected power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=12;" edge="1" parent="1" source="energy" target="propulsion">
