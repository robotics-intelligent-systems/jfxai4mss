  <diagram id="RV-5" name="05 — Interfaces and modes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Modular Amphibious RV Requirements&lt;br&gt;&lt;b&gt;05 — Interfaces and modes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="mechanical" value="&lt;b&gt;Mechanical contract&lt;/b&gt;&lt;br&gt;Mount geometry, load path, retention, mass/CG limits, compartment penetrations, handling and maintenance clearances.&lt;br&gt;Values: TBD; configuration-specific." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="power" value="&lt;b&gt;Power contract&lt;/b&gt;&lt;br&gt;Bus voltage/current ratings, connectors, polarity, grounding/isolation, source/load metering, reserve and emergency disconnect.&lt;br&gt;Values: TBD; selected architecture." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Data / command contract&lt;/b&gt;&lt;br&gt;asset_id, configuration_id, mode, position/heading, energy, propulsion, water/environment, health/faults, timestamp, units, quality, source, model/software versions.&lt;br&gt;Commands: authority, allowed modes, acknowledgment and expiration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="modes" value="&lt;b&gt;Baseline modes&lt;/b&gt;&lt;br&gt;SAFE / ISOLATED&lt;br&gt;MANUAL WATER NAVIGATION&lt;br&gt;DOCKED / HABITATION&lt;br&gt;SHORE / RENEWABLE CHARGING&lt;br&gt;DEGRADED / RECOVERY&lt;br&gt;MAINTENANCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="guards" value="&lt;b&gt;Mode guards&lt;/b&gt;&lt;br&gt;Approve a guard/fault table covering personnel access, module retention, source isolation, sensor validity and operator authority. Faults inhibit affected actions and enter a defined recovery state. Maintenance/module changes require propulsion isolation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="variants" value="&lt;b&gt;Variant decision&lt;/b&gt;&lt;br&gt;Land transitions, hydrogen generation, turbines, foils and extra renewables require their own geometry, interfaces, hazard analysis and acceptance budgets; they are not inferred from an image or historical filename." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
