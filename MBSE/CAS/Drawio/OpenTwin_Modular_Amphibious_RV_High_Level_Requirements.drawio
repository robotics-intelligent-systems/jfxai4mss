        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="RV-10" value="&lt;b&gt;RV-10 — Dashboard provenance&lt;/b&gt;&lt;br&gt;SHALL treat illustrated energy/water percentages, location and 5.2 kn speed as UI examples rather than performance or capacity limits.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/T&lt;/b&gt;&lt;br&gt;Verify examples are labeled and replaced by measured or simulated values carrying quality and provenance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
