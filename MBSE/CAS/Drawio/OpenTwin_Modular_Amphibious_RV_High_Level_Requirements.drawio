        <mxCell id="configuration" value="&lt;b&gt;Configuration baseline&lt;/b&gt;&lt;br&gt;CAD IDs, module inventory, budgets, interface contracts and evidence&lt;br&gt;&lt;br&gt;Design allocation: RV-09, COM-01, COM-04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
