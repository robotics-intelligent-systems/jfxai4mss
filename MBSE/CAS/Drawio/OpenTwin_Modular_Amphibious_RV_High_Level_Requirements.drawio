          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="simulation" value="&lt;b&gt;Models / cloud analytics&lt;/b&gt;&lt;br&gt;Modelica, hydrodynamics, co-simulation, replay and twin validation&lt;br&gt;&lt;br&gt;Design allocation: COM-05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
