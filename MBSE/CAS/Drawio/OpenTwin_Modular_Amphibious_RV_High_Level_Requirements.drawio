        <mxCell id="hull" value="&lt;b&gt;Hull / structure&lt;/b&gt;&lt;br&gt;Geometry, compartments, mass/CG, loading and hydrodynamics&lt;br&gt;&lt;br&gt;Design allocation: RV-02, COM-06, COM-07" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
