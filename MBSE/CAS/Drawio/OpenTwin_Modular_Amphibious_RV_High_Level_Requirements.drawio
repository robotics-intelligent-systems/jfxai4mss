  <diagram id="RV-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Modular Amphibious RV Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;MBSE/CAD/amphibious-rv-concept.jpg&lt;br&gt;&lt;br&gt;Illustrated callouts are concept evidence; dimensions and performance require design/analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Baseline interpretation&lt;/b&gt;&lt;br&gt;Habitation, roof PV/deck, modular batteries, water tanks, power conversion, HVAC, marine drive and IoT are illustrated. A land chassis, towing arrangement and launch mechanism are not defined." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Requirements status&lt;/b&gt;&lt;br&gt;Proposed high-level requirements. Named owners are proposed engineering roles, not assigned people. Acceptance budgets and dates require project assignment. No completion/certification claim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission / stakeholders&lt;/b&gt;&lt;br&gt;Operator, occupants/crew, payload team, naval architect, controls/energy engineers and maintainers.&lt;br&gt;Scenario: configure → inspect → operate under local authority → dock/recover → maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="shared" value="&lt;b&gt;Shared requirements allocation&lt;/b&gt;&lt;br&gt;Allocate COM-01 through COM-12 from OpenTwin_Marine_Common_High_Level_Requirements.drawio alongside this asset specification.&lt;br&gt;Traceability register: docs/requirements/cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Boundary / exclusions&lt;/b&gt;&lt;br&gt;Concept requirements and interfaces for MBSE/CAD/simulation. Numerical budgets, production geometry and verification evidence are unresolved. Unillustrated variants require a separate configuration decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="RV-2" name="02 — High-level requirements 1–9">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Modular Amphibious RV Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="72" />
        </mxCell>
        <mxCell id="footer" value="CONCEPT / PROPOSED • CAD illustration ≠ validated geometry • SHALL requirements need approved acceptance budgets • I: inspection · A: analysis · D: demonstration · T: test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="RV-01" value="&lt;b&gt;RV-01 — Living module&lt;/b&gt;&lt;br&gt;SHALL provide configurable sleeping, seating, galley, sanitation, storage and workspace for an approved occupancy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/D&lt;/b&gt;&lt;br&gt;Inspect a habitation arrangement against the CAD living-space callouts and demonstrate access/egress." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-02" value="&lt;b&gt;RV-02 — Roof deck and PV&lt;/b&gt;&lt;br&gt;SHALL separate roof leisure/workspace access from photovoltaic arrays and provide guarded access and controlled structural loads.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/I&lt;/b&gt;&lt;br&gt;Analyze occupied roof loads, CG and stability; inspect guards, access and PV maintenance clearances." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-03" value="&lt;b&gt;RV-03 — Battery and conversion&lt;/b&gt;&lt;br&gt;SHALL provide modular battery banks and protected inverter/DC-AC interfaces; evaluate the depicted LiFePO4 chemistry as a candidate selection.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/T&lt;/b&gt;&lt;br&gt;Review chemistry selection, mounting, thermal/protection design and source-fault shutdown against the approved criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-04" value="&lt;b&gt;RV-04 — Electric marine drive&lt;/b&gt;&lt;br&gt;SHALL provide modular electric marine propulsion and local steering/stop with propulsion health telemetry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Demonstrate maneuvering and emergency stop plus timestamped command/state/fault telemetry in the approved water envelope." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-05" value="&lt;b&gt;RV-05 — Water and waste&lt;/b&gt;&lt;br&gt;SHALL separate potable, grey and black water tanks, plumbing and service interfaces; monitor levels and prevent cross-connection.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/T&lt;/b&gt;&lt;br&gt;Inspect independent circuits and demonstrate level alarms, leak response and service access against the approved capacities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-06" value="&lt;b&gt;RV-06 — Climate and utilities&lt;/b&gt;&lt;br&gt;SHALL provide ventilation, HVAC, lighting and essential habitation loads within the energy reserve and thermal budgets.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: A/T&lt;/b&gt;&lt;br&gt;Verify climate and power budgets for approved occupancy/environment conditions and demonstrate priority-load behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-07" value="&lt;b&gt;RV-07 — Navigation and IoT&lt;/b&gt;&lt;br&gt;SHALL integrate GPS/GNSS, AIS, selected camera/radar and environment/security sensors into local navigation and monitoring.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Replay navigation/sensor faults and verify validity flags, alarms and safe local operation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-08" value="&lt;b&gt;RV-08 — Remote access&lt;/b&gt;&lt;br&gt;SHALL provide authorized remote monitoring and open APIs over selected cellular or optional satellite links with local buffering.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: T&lt;/b&gt;&lt;br&gt;Demonstrate authorized access, disconnected operation and ordered reconnect without duplicate command execution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="RV-09" value="&lt;b&gt;RV-09 — Land-water variant&lt;/b&gt;&lt;br&gt;SHALL define towing/chassis, road interfaces and launch/recovery only after a dedicated land configuration is designed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification: I/A&lt;/b&gt;&lt;br&gt;Record land capability as unresolved; acceptance requires transport geometry, mass, coupling/braking and transition load evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
